```cshtml
@model IEnumerable<pms_mvc_example.Models.Product>

@{
    ViewData["Title"] = "Our Products";
}

<style>
    .products-page {
        padding: 35px 0;
    }

    .products-heading {
        text-align: center;
        margin-bottom: 35px;
    }

        .products-heading h1 {
            font-weight: 800;
            color: #4f3674;
            margin-bottom: 10px;
        }

        .products-heading p {
            color: #777;
            font-size: 16px;
        }

    .product-card {
        height: 100%;
        border: 1px solid #e6d9f5;
        border-radius: 18px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 5px 20px rgba(79, 54, 116, 0.10);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

        .product-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 10px 25px rgba(79, 54, 116, 0.16);
        }

    .product-image-container {
        height: 220px;
        padding: 15px;
        background: #f8f3ff;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .product-image {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .image-placeholder {
        color: #8065a7;
        text-align: center;
        font-size: 15px;
    }

    .product-title {
        color: #4f3674;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .product-description {
        color: #777;
        min-height: 24px;
    }

    .product-price {
        color: #6841a5;
        font-size: 23px;
        font-weight: 800;
        margin: 15px 0;
    }

    .product-details {
        color: #555;
        margin-bottom: 10px;
    }

    .product-status {
        display: inline-block;
        padding: 6px 13px;
        border-radius: 20px;
        background: #eee5f8;
        color: #563786;
        font-size: 13px;
        font-weight: 600;
    }

    .product-buttons {
        display: flex;
        gap: 10px;
        margin-top: 22px;
    }

        .product-buttons a {
            flex: 1;
            display: inline-block;
            text-align: center;
            padding: 10px 8px;
            border-radius: 9px;
            text-decoration: none !important;
            font-weight: 600;
            transition: background-color 0.2s ease;
        }

            /* Purple Edit button */
            .product-buttons a.btn-edit,
            .product-buttons a.btn-edit:visited {
                background-color: #6841a5 !important;
                color: #ffffff !important;
                border: 1px solid #6841a5 !important;
            }

                .product-buttons a.btn-edit:hover {
                    background-color: #4f3674 !important;
                    color: #ffffff !important;
                }

            /* Lavender Delete button */
            .product-buttons a.btn-delete,
            .product-buttons a.btn-delete:visited {
                background-color: #e6d9f5 !important;
                color: #4f3674 !important;
                border: 1px solid #c8b6e2 !important;
            }

                .product-buttons a.btn-delete:hover {
                    background-color: #c8b6e2 !important;
                    color: #3d285d !important;
                    border-color: #b49bd6 !important;
                }

    /* Add Product button */
    .btn-add {
        display: inline-block;
        padding: 12px 22px;
        background-color: #6841a5 !important;
        color: #ffffff !important;
        border: 1px solid #6841a5;
        border-radius: 10px;
        text-decoration: none !important;
        font-weight: 600;
        transition: background-color 0.2s ease;
    }

        .btn-add:hover {
            background-color: #4f3674 !important;
            color: #ffffff !important;
        }

    .success-message {
        padding: 14px 18px;
        border-radius: 10px;
        background: #eee5f8;
        color: #4f3674;
        margin-bottom: 25px;
    }

    .empty-message {
        text-align: center;
        padding: 45px 20px;
        background: #f8f3ff;
        border-radius: 16px;
        color: #4f3674;
    }
</style>

<div class="container products-page">

    <div class="products-heading">
        <h1>Our Products</h1>
        <p>Discover our lovely collection of products.</p>

        <a asp-controller="Products"
           asp-action="Create"
           class="btn-add">
            + Add New Product
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="success-message">
            @TempData["Success"]
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">

            @foreach (var product in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">

                    <div class="card product-card">

                        <div class="product-image-container">

                            @{
                                var imageFile = product.Image?.Trim();

                                if (!string.IsNullOrWhiteSpace(imageFile))
                                {
                                    imageFile = imageFile.Replace("\\", "/");

                                    if (imageFile.StartsWith("~/"))
                                    {
                                        imageFile = imageFile.Substring(1);
                                    }
                                    else if (!imageFile.StartsWith("/"))
                                    {
                                        imageFile = "/" + imageFile;
                                    }
                                }
                            }

                            @if (!string.IsNullOrWhiteSpace(imageFile))
                            {
                                <img src="@Url.Content("~" + imageFile)"
                                     alt="@product.Title"
                                     class="product-image"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />

                                <div class="image-placeholder"
                                     style="display:none;">
                                    Image not found
                                </div>
                            }
                            else
                            {
                                <div class="image-placeholder">
                                    No image available
                                </div>
                            }

                        </div>

                        <div class="card-body p-4">

                            <h4 class="product-title">
                                @product.Title
                            </h4>

                            <p class="product-description">
                                @product.Description
                            </p>

                            <div class="product-price">
                                Rs. @product.Price.ToString("N0")
                            </div>

                            <p class="product-details">
                                <strong>Quantity:</strong>
                                @product.Quantity
                            </p>

                            <p class="product-details">
                                <strong>Status:</strong>
                                <span class="product-status">
                                    @product.Status
                                </span>
                            </p>

                            <div class="product-buttons">

                                <a asp-controller="Products"
                                   asp-action="Edit"
                                   asp-route-id="@product.Id"
                                   class="btn-edit">
                                    Edit
                                </a>

                                <a asp-controller="Products"
                                   asp-action="Delete"
                                   asp-route-id="@product.Id"
                                   class="btn-delete">
                                    Delete
                                </a>

                            </div>

                        </div>
                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="empty-message">
            <h4>No products found</h4>

            <p>Add products to your database to display them here.</p>

            <a asp-controller="Products"
               asp-action="Create"
               class="btn-add">
                Add Your First Product
            </a>
        </div>
    }

</div>
```